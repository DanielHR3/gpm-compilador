<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.gpmc.servidor</string>

  <key>ProgramArguments</key>
  <array>
    <string>__RUTA__/.venv/bin/gpmc</string>
    <string>servir</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--puerto</string>
    <string>8000</string>
    <!-- Sin esto las sesiones son temporales: se pierden al reiniciar, y este
         servicio tiene KeepAlive, o sea que se reinicia solo cuando se cae.
         Un analista a media revision perderia su expediente. -->
    <string>--almacen</string>
    <string>__ALMACEN__</string>
    <!-- El registro va a un archivo APARTE de StandardOutPath, y con rotacion.
         launchd mantiene abierto el descriptor de `servidor.log`, asi que ese
         no se puede rotar desde dentro; ahi quedan solo el arranque y lo que
         reviente antes de configurar nada. -->
    <string>--log</string>
    <string>__REGISTRO__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__RUTA__</string>

  <!-- Arranca al iniciar sesion y se reinicia solo si se cae. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Sin esto la bitacora sale vacia: Python bufferea cuando no hay terminal. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
  </dict>

  <!-- El log NO puede vivir dentro del repo si este cuelga de ~/Desktop,
       ~/Documents o ~/Downloads: macOS no deja que un agente de launchd cree
       ahi sus archivos de stdout/stderr, y el trabajo muere con EX_CONFIG (78)
       antes de arrancar, sin dejar rastro. Lo que el propio proceso escriba
       despues si funciona -- el almacen de sesiones puede estar donde sea. -->
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
